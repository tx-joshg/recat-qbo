{
  "name": "@recat/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:pg",
    "seed": "tsx src/seed.ts",
    "test:unit": "vitest run",
    "test:pg": "vitest run --config vitest.pg.config.ts",
    "rules:canonical-backfill": "node dist/cli/backfillCanonicalRules.js",
    "rules:rollback-guard": "node dist/cli/prepareRuleRollback.js"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@opentelemetry/api": "^1.9.1",
    "@prisma/client": "^6.10.0",
    "@recat/shared": "*",
    "archiver": "8.0.0",
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.21.2",
    "file-type": "^22.0.1",
    "nodemailer": "^9.0.3",
    "zod": "^3.24.1",
    "zod-to-json-schema": "3.25.2",
    "zod-v4": "npm:zod@4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/conformance": "0.2.0-alpha.10",
    "@types/archiver": "8.0.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.2.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  }
}
