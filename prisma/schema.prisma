generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  categorizer
  viewer
}

enum TxnStatus {
  PENDING
  POSTING
  POSTED
  DRY_RUN
  ERROR
  SUPERSEDED
  REVERTED
}

/// The current QuickBooks provider disposition is deliberately separate from
/// Recat's local mutation lifecycle.  A row may remain PENDING locally while
/// QuickBooks has already cleared/reconciled it, and that distinction must be
/// queryable without overloading TxnStatus.
enum ProviderActionability {
  UNKNOWN
  WRITABLE
  BLOCKED_CLEARED
  BLOCKED_RECONCILED
  BLOCKED_PERIOD_CLOSED
  UNAVAILABLE
}

enum SyncMode {
  polling
  webhook
}

enum QboEnv {
  sandbox
  production
}

enum RuleRuntimeMode {
  legacy
  bridge
  paused
  canonical
}

enum RuleDirection {
  Purchase
  Deposit
}

enum AttachmentSourceKind {
  LOCAL_UPLOAD
  HTTPS_IMPORT
  QBO_EXTERNAL
}

enum AttachmentStatus {
  STAGED
  UPLOADING
  ATTACHED
  FAILED
  UNCERTAIN
  RECONCILING
  DELETING
  DELETED
  QBO_MISSING
}

enum AttachmentOperationStatus {
  PREPARED
  COMMITTING
  PARTIAL
  VERIFIED
  FAILED
  UNCERTAIN
  DELETING
  DELETED
}

enum AttachmentOperationKind {
  ATTACH
  DELETE_LOCAL
  DELETE_EVERYWHERE
}

enum AttachmentBlobState {
  STAGING
  READY
}

enum ReceiptDocumentStatus {
  RECEIVED
  QUEUED
  PROCESSING
  NEEDS_REVIEW
  READY
  MATCHED
  ATTACHING
  ATTACHED
  FAILED
}

enum ReceiptSourceKind {
  WEB_UPLOAD
  API_UPLOAD
  MCP_UPLOAD
}

model User {
  id              String           @id @default(uuid())
  email           String           @unique
  name            String?
  /// Instance admins manage instance settings, users, and company connections,
  /// and implicitly hold the admin role in every company.
  isInstanceAdmin Boolean          @default(false)
  invitePending   Boolean          @default(false)
  dashboardLayout Json?
  createdAt       DateTime         @default(now())
  magicLinks      MagicLinkToken[]
  sessions        Session[]
  memberships     Membership[]
  mcpTokens       McpToken[]
  receiptsCreated  ReceiptDocument[] @relation("ReceiptCreatedBy")
  receiptsApproved ReceiptDocument[] @relation("ReceiptApprovedBy")
  receiptEvents    ReceiptEvent[]
}

/// Per-company role (handoff §5 matrix, scoped per specs.md §2).
model Membership {
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      Role

  @@id([userId, companyId])
}

model MagicLinkToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  /// Issuance prunes this user's spent and expired tokens before creating a
  /// new one. Without this the cleanup scans the whole table on every public
  /// magic-link request; Postgres does not index foreign keys automatically.
  @@index([userId, expiresAt])
}

model Session {
  id        String   @id @default(uuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model McpToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  digest     String    @unique @db.Char(64)
  prefix     String    @db.VarChar(12)
  label      String    @db.VarChar(80)
  expiresAt  DateTime
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
  revokedAt  DateTime?

  @@index([userId, createdAt])
}

// Append-only security events. The app exposes create-only service access.
model SecurityAuditEvent {
  id            String   @id @default(uuid())
  // Immutable attribution scalar: deliberately no User FK, so account deletion
  // cannot erase or rewrite the original actor ID.
  actorUserId   String
  action        String   @db.VarChar(64)
  subjectId     String   @db.VarChar(64)
  subjectPrefix String   @db.VarChar(16)
  at            DateTime @default(now())

  @@index([actorUserId, at])
}

model Company {
  id                String        @id @default(uuid())
  realmId           String        @unique
  legalName         String
  nickname          String
  env               QboEnv        @default(sandbox)
  syncMode          SyncMode      @default(polling)
  /// Bridge-safe rollout fence. Old binaries omit this field and remain in
  /// legacy behavior until an explicit cutover changes the value.
  ruleRuntimeMode   RuleRuntimeMode @default(legacy)
  pollIntervalMin   Int           @default(10)
  holdingAccountIds Json          @default("[]")
  dryRun            Boolean       @default(true)
  tagsRequired      Boolean       @default(false)
  retainAttachmentFiles Boolean   @default(true)
  attachmentQuotaBytes BigInt?
  attachmentRetentionDays Int?
  accessToken       String? // encrypted (AES-256-GCM)
  refreshToken      String? // encrypted (AES-256-GCM)
  tokenExpiresAt    DateTime?
  connectedAt       DateTime      @default(now())
  disconnectedAt    DateTime?
  lastSyncedAt      DateTime?
  taxReferenceRefreshedAt DateTime?
  taxUsingSalesTax        Boolean?
  taxSupportStatus        String        @default("needs_setup")
  taxSupportReason        String?
  transactions      Transaction[]
  transactionActionability TransactionActionability[]
  tags              Tag[]
  rules             Rule[]
  savedReports      SavedReport[]
  auditEntries      AuditEntry[]
  qboAccounts       QboAccount[]
  qboTaxRates       QboTaxRate[]
  qboTaxCodes       QboTaxCode[]
  syncLogs          SyncLog[]
  memberships       Membership[]
  logTags           LogTag[]
  agentConfig       AgentCompanyConfig?
  agentJobs         AgentJob[]
  agentRuns         AgentRun[]
  autopilotRuleCandidates AutopilotRuleCandidate[]
  autopilotRuleCandidateEvidence AutopilotRuleCandidateEvidence[]
  autopilotRuleCandidateFolds AutopilotRuleCandidateFold[]
  liveWritePermits LiveWritePermit[]
  attachmentBlobs AttachmentBlob[]
  stagedAttachments StagedAttachment[]
  transactionAttachments TransactionAttachment[]
  attachmentOperations AttachmentOperation[]
  attachmentUploadGrants AttachmentUploadGrant[]
  attachmentDownloadGrants AttachmentDownloadGrant[]
  receiptDocuments ReceiptDocument[]
  receiptProcessingJobs ReceiptProcessingJob[]
  receiptIntakeOperations ReceiptIntakeOperation[]
  receiptCompanyConfig ReceiptCompanyConfig?
  receiptEvents ReceiptEvent[]
  qboTokenRevocations QboTokenRevocation[]
  vendorIdentities            VendorIdentity[]
  vendorAliases               VendorAlias[]
  vendorIdentityMerges        VendorIdentityMerge[]
  classificationCases         ClassificationCase[]
  classificationCaseInvalidations ClassificationCaseInvalidation[]
  historicalClassificationObservations HistoricalClassificationObservation[]
  ruleRevisions               RuleRevision[]
  ruleCanonicalMigrations     RuleCanonicalMigration[]
  ruleAutoPostPreparations    RuleAutoPostPreparation[]
  rulePreparationRetries      RulePreparationRetry[]
  classificationCorpusRevisions ClassificationCorpusRevision[]
  ruleLifecycleRevision       RuleLifecycleRevision?
}

/// Append-only company-local freshness fence for the classification retrieval
/// corpus. Database triggers append one event transactionally with every
/// canonical write; the global sequence avoids a tenant-wide mutation lock.
model ClassificationCorpusRevision {
  revision BigInt   @id @default(autoincrement())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([companyId, revision(sort: Desc)])
}

/// Constant-state company-local fence for lifecycle pagination. Database
/// triggers update it transactionally for canonical, legacy, and direct writes.
model RuleLifecycleRevision {
  companyId String  @id
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  revision  BigInt
}

/// Quarantined disconnect snapshots, never active connection credentials.
model QboTokenRevocation {
  id                    String   @id @default(uuid())
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  realmId               String
  encryptedRefreshToken String
  createdAt             DateTime @default(now())
  leaseOwner            String?
  leaseExpiresAt        DateTime?

  @@index([companyId])
  @@index([leaseExpiresAt, createdAt])
}

model Transaction {
  id             String    @id @default(uuid())
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qboId          String
  qboType        String // Purchase | Deposit | JournalEntry
  qboSyncToken   String
  date           DateTime
  payee          String
  memo           String?
  amount         Decimal   @db.Decimal(14, 2) // signed; + = money in
  bankAccount    String
  status         TxnStatus @default(PENDING)
  revision       Int       @default(0)
  category       String? // chosen category display name (single-category case)
  categoryQboId  String? // chosen QBO account id (single-category case)
  taxCalculation String?
  taxCode        String?
  taxCodeQboId   String?
  splitLines     SplitLine[] // when present, replaces category (multi-category)
  suggestion     Json? // { category, categoryQboId?, source: 'rule'|'history'|'ai', ruleId? }
  errorCode      String?
  errorMessage   String?
  postedAt       DateTime?
  postedByUserId String?
  rawData        Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  txnTags        TxnTag[]
  qboMutationAttempts QboMutationAttempt[]
  autopilotRuleCandidateEvidence AutopilotRuleCandidateEvidence[]
  autopilotRuleCandidateFolds AutopilotRuleCandidateFold[]
  attachments TransactionAttachment[]
  attachmentOperations AttachmentOperation[]
  matchedReceipts ReceiptDocument[]
  receiptMatchCandidates ReceiptMatchCandidate[]
  providerActionability TransactionActionability?
  classificationCases            ClassificationCase[]
  historicalClassificationObservations HistoricalClassificationObservation[]

  @@unique([companyId, qboType, qboId])
  // Composite identity lets every company-owned child prove its tenant in
  // the database, rather than relying on a caller to pair IDs correctly.
  @@unique([companyId, id])
  @@index([companyId, status])
}

/// Latest bounded, read-only QuickBooks write-safety observation for a
/// transaction.  This is an index, not an authorization record: every actual
/// write still performs a fresh provider read through assertQboWriteAllowed.
/// The scalar transaction binding is retained so an observation can never be
/// mistaken for another QBO entity after a sync or local revision change.
model TransactionActionability {
  id                 String               @id @default(uuid())
  companyId          String
  company            Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId      String               @unique
  transaction        Transaction          @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  disposition        ProviderActionability @default(UNKNOWN)
  checkedAt          DateTime?
  revision           Int
  qboSyncToken       String               @db.VarChar(128)
  qboType            String               @db.VarChar(32)
  qboId              String               @db.VarChar(128)
  txnDate            DateTime             @db.Date
  bankAccountQboId   String?              @db.VarChar(128)
  bookCloseDate      DateTime?            @db.Date
  cleared            Boolean?
  reconciled         Boolean?
  unavailableCode    String?              @db.VarChar(64)
  unavailableReason  String?              @db.VarChar(500)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([companyId, disposition, checkedAt])
  @@index([companyId, transactionId, revision, qboSyncToken])
}

model AttachmentBlob {
  id          String                  @id @default(uuid())
  companyId   String
  company     Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  state       AttachmentBlobState     @default(STAGING)
  sha256      String?                 @db.Char(64)
  sizeBytes   BigInt                  @default(0)
  contentType String?                 @db.VarChar(120)
  chunkCount  Int                     @default(0)
  expiresAt   DateTime?
  createdAt   DateTime                @default(now())
  chunks      AttachmentBlobChunk[]
  stagedFiles StagedAttachment[]
  attachments TransactionAttachment[]
  receiptDocuments ReceiptDocument[]

  @@unique([companyId, sha256])
  @@index([companyId, state])
  @@index([state, expiresAt])
}

model AttachmentBlobChunk {
  blobId  String
  blob    AttachmentBlob @relation(fields: [blobId], references: [id], onDelete: Cascade)
  ordinal Int
  content Bytes

  @@id([blobId, ordinal])
}

model StagedAttachment {
  id               String               @id @default(uuid())
  companyId        String
  company          Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  actorKey         String               @db.VarChar(160)
  blobId           String
  blob             AttachmentBlob       @relation(fields: [blobId], references: [id], onDelete: Restrict)
  originalFilename String               @db.VarChar(255)
  contentType      String               @db.VarChar(120)
  sizeBytes        BigInt
  sourceKind       AttachmentSourceKind
  retainLocally    Boolean
  expiresAt        DateTime
  consumedAt       DateTime?
  createdAt        DateTime             @default(now())

  @@index([companyId, actorKey, expiresAt])
}

model TransactionAttachment {
  id               String                    @id @default(uuid())
  companyId        String
  company          Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId    String
  transaction      Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  blobId           String?
  blob             AttachmentBlob?           @relation(fields: [blobId], references: [id], onDelete: SetNull)
  originalFilename String                    @db.VarChar(255)
  contentType      String                    @db.VarChar(120)
  sizeBytes        BigInt
  sha256           String                    @db.Char(64)
  sourceKind       AttachmentSourceKind
  retainLocally    Boolean
  status           AttachmentStatus          @default(STAGED)
  qboAttachableId  String?                   @db.VarChar(128)
  qboSyncToken     String?                   @db.VarChar(64)
  recatMarker      String                    @unique @db.Uuid
  errorCode        String?                   @db.VarChar(64)
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  operationFiles   AttachmentOperationFile[]
  downloadGrants   AttachmentDownloadGrant[]
  receiptDocument  ReceiptDocument?

  @@unique([companyId, qboAttachableId])
  @@index([companyId, transactionId, status])
}

model AttachmentOperation {
  id             String                    @id @default(uuid())
  kind           AttachmentOperationKind   @default(ATTACH)
  actorKey       String                    @db.VarChar(160)
  companyId      String
  company        Company                   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId  String
  transaction    Transaction               @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  receiptDocumentId String?
  receiptDocument   ReceiptDocument?        @relation(fields: [receiptDocumentId], references: [id], onDelete: Cascade)
  idempotencyKey String                    @db.VarChar(128)
  requestHash    String                    @db.Char(64)
  inputHash      String                    @db.Char(64)
  status         AttachmentOperationStatus @default(PREPARED)
  fileCount      Int
  totalBytes     BigInt
  errorCode      String?                   @db.VarChar(64)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  files          AttachmentOperationFile[]

  @@unique([actorKey, companyId, transactionId, idempotencyKey])
  @@index([companyId, transactionId, status])
  @@index([receiptDocumentId, status])
}

model AttachmentOperationFile {
  operationId  String
  operation    AttachmentOperation   @relation(fields: [operationId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   TransactionAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  ordinal      Int
  status       AttachmentStatus
  errorCode    String?               @db.VarChar(64)
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@id([operationId, attachmentId])
  @@unique([operationId, ordinal])
  @@index([attachmentId, status])
}

model AttachmentUploadGrant {
  id           String    @id @default(uuid())
  tokenHash    String    @unique @db.Char(64)
  actorKey     String    @db.VarChar(160)
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  maxFileCount Int
  maxBytes     BigInt
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([companyId, actorKey, expiresAt])
}

model AttachmentDownloadGrant {
  id           String                @id @default(uuid())
  tokenHash    String                @unique @db.Char(64)
  actorKey     String                @db.VarChar(160)
  companyId    String
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attachmentId String
  attachment   TransactionAttachment @relation(fields: [attachmentId], references: [id], onDelete: Cascade)
  expiresAt    DateTime
  usedAt       DateTime?
  createdAt    DateTime              @default(now())

  @@index([companyId, actorKey, expiresAt])
}

model ReceiptDocument {
  id                         String                     @id @default(uuid())
  companyId                  String
  company                    Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  blobId                     String?
  blob                       AttachmentBlob?            @relation(fields: [blobId], references: [id], onDelete: SetNull)
  originalFilename           String                     @db.VarChar(255)
  contentType                String                     @db.VarChar(120)
  sizeBytes                  BigInt
  sha256                     String                     @db.Char(64)
  sourceKind                 ReceiptSourceKind
  sourceExternalId           String?                    @db.VarChar(200)
  status                     ReceiptDocumentStatus      @default(RECEIVED)
  generation                 Int                        @default(1)
  revision                   Int                        @default(0)
  pageCount                  Int?
  retainLocally              Boolean                    @default(true)
  userNotes                  String?                    @db.Text
  manuallyEdited             Boolean                    @default(false)
  currentMetadata            Json                       @default("{}")
  lastExportedAt             DateTime?
  createdByUserId            String?
  createdByUser              User?                      @relation("ReceiptCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  matchedTransactionId       String?
  matchedTransaction         Transaction?               @relation(fields: [matchedTransactionId], references: [id], onDelete: SetNull)
  matchedTransactionRevision Int?
  transactionAttachmentId    String?                    @unique
  transactionAttachment      TransactionAttachment?     @relation(fields: [transactionAttachmentId], references: [id], onDelete: SetNull)
  approvedAt                 DateTime?
  approvedByUserId           String?
  approvedByUser             User?                      @relation("ReceiptApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  deletedAt                  DateTime?
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  jobs                       ReceiptProcessingJob[]
  attempts                   ReceiptExtractionAttempt[]
  candidates                 ReceiptMatchCandidate[]
  events                     ReceiptEvent[]
  attachmentOperations       AttachmentOperation[]

  @@unique([companyId, blobId])
  @@unique([companyId, sha256])
  @@unique([companyId, sourceKind, sourceExternalId])
  @@index([companyId, status, createdAt])
  @@index([companyId, deletedAt, createdAt])
}

model ReceiptProcessingJob {
  id             String                     @id @default(uuid())
  documentId     String
  document       ReceiptDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  companyId      String
  company        Company                    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  generation     Int
  configVersion  String                     @db.Char(64)
  status         String                     @db.VarChar(16)
  dueAt          DateTime
  lockOwner      String?                    @db.VarChar(200)
  leaseExpiresAt DateTime?
  attemptCount   Int                        @default(0)
  lastErrorCode  String?                    @db.VarChar(64)
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  attempts       ReceiptExtractionAttempt[]

  @@unique([documentId, generation])
  @@index([status, dueAt])
  @@index([companyId, status])
}

model ReceiptIntakeOperation {
  id             String   @id @default(uuid())
  actorKey       String   @db.VarChar(160)
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  idempotencyKey String   @db.VarChar(128)
  requestHash    String   @db.Char(64)
  receiptIds     Json
  createdAt      DateTime @default(now())

  @@unique([actorKey, companyId, idempotencyKey])
  @@index([companyId, createdAt])
}

model ReceiptExtractionAttempt {
  id                   String                   @id @default(uuid())
  jobId                String
  job                  ReceiptProcessingJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  documentId           String
  document             ReceiptDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  generation           Int
  attemptCount         Int
  status               String                   @db.VarChar(16)
  result               Json?
  receiptDate          DateTime?                @db.Date
  documentTitle        String?                  @db.VarChar(500)
  vendorName           String?                  @db.VarChar(500)
  vendorTaxId          String?                  @db.VarChar(200)
  vendorReceiptId      String?                  @db.VarChar(200)
  clientName           String?                  @db.VarChar(500)
  clientTaxId          String?                  @db.VarChar(200)
  description          String?                  @db.Text
  lineItems            Json?
  subtotal             Decimal?                 @db.Decimal(18, 4)
  taxAmount            Decimal?                 @db.Decimal(18, 4)
  totalAmount          Decimal?                 @db.Decimal(18, 4)
  currency             String?                  @db.VarChar(3)
  convertedAmount      Decimal?                 @db.Decimal(18, 4)
  conversionRate       Decimal?                 @db.Decimal(18, 8)
  paymentMethod        String?                  @db.VarChar(80)
  paymentIdentifier    String?                  @db.VarChar(200)
  language             String?                  @db.VarChar(16)
  additionalFields     Json?
  rawExtractedText     String?                  @db.Text
  documentType         String?                  @db.VarChar(80)
  category             String?                  @db.VarChar(500)
  extractionConfidence Decimal?                 @db.Decimal(5, 4)
  taxComponents        Json?
  parseSalvaged        Boolean                  @default(false)
  warnings             Json?
  model                String                   @db.VarChar(200)
  promptVersion        String                   @db.VarChar(120)
  schemaVersion        String                   @db.VarChar(120)
  tokensIn             Int                      @default(0)
  tokensOut            Int                      @default(0)
  costUsd              Decimal?                 @db.Decimal(14, 8)
  durationMs           Int?
  errorCode            String?                  @db.VarChar(64)
  startedAt            DateTime                 @default(now())
  completedAt          DateTime?
  candidates           ReceiptMatchCandidate[]
  searchVector         Unsupported("tsvector")? @default(dbgenerated("to_tsvector('simple'::regconfig, (((((((((((((COALESCE(\"documentTitle\", ''::character varying))::text || ' '::text) || (COALESCE(\"vendorName\", ''::character varying))::text) || ' '::text) || (COALESCE(\"vendorTaxId\", ''::character varying))::text) || ' '::text) || (COALESCE(\"vendorReceiptId\", ''::character varying))::text) || ' '::text) || COALESCE(description, ''::text)) || ' '::text) || COALESCE(\"rawExtractedText\", ''::text)) || ' '::text) || (COALESCE(currency, ''::character varying))::text))")) @map("search_vector")

  @@unique([jobId, attemptCount])
  @@index([documentId, generation])
  @@index([documentId, completedAt])
  @@index([searchVector], type: Gin)
}

model ReceiptMatchCandidate {
  id                  String                   @id @default(uuid())
  documentId          String
  document            ReceiptDocument          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionAttemptId String
  extractionAttempt   ReceiptExtractionAttempt @relation(fields: [extractionAttemptId], references: [id], onDelete: Cascade)
  transactionId       String
  transaction         Transaction              @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  transactionRevision Int
  score               Int
  evidence            Json
  rank                Int
  state               String                   @default("proposed") @db.VarChar(16)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([extractionAttemptId, transactionId])
  @@index([documentId, rank])
  @@index([transactionId, state])
}

model ReceiptCompanyConfig {
  companyId           String   @id
  company             Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enabled             Boolean  @default(false)
  provider            String   @default("openrouter") @db.VarChar(32)
  model               String   @default("openai/gpt-4o-mini") @db.VarChar(200)
  confidenceThreshold Decimal  @default(0.8) @db.Decimal(5, 4)
  autoMatchThreshold  Int      @default(85)
  autoMatchMargin     Int      @default(15)
  maxPages            Int      @default(20)
  configVersion       String   @db.Char(64)
  updatedAt           DateTime @updatedAt
}

model ReceiptEvent {
  id          String          @id @default(uuid())
  companyId   String
  company     Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  documentId  String
  document    ReceiptDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actorUserId String?
  actorUser   User?           @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action      String          @db.VarChar(64)
  before      Json?
  after       Json?
  createdAt   DateTime        @default(now())

  @@index([documentId, createdAt])
  @@index([companyId, createdAt])
}

model Tag {
  id            String         @id @default(uuid())
  companyId     String
  company       Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name          String
  color         String
  createdAt     DateTime       @default(now())
  txnTags       TxnTag[]
  ruleTags      RuleTag[]
  splitLineTags SplitLineTag[]
  logTags       LogTag[]
}

/// Tag on a QuickBooks transaction that never passed through Recat's queue
/// (tagged from the transaction log). Transactions Recat synced keep their
/// tags on TxnTag — the log endpoint merges both, and tag edits route to
/// TxnTag whenever a local Transaction row exists for the same entity.
model LogTag {
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// "<qboType>:<qboId>" — canonical entity type (Purchase | Deposit |
  /// JournalEntry) where known, else the report's type string verbatim.
  /// Rows QBO returned without an entity id instead carry the synthetic
  /// "row:<hash>" key from reports.ts fallbackLogKey, so they stay taggable.
  qboKey    String
  tagId     String
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([companyId, qboKey, tagId])
  @@index([companyId, qboKey])
}

/// One line of a split categorization. Reports attribute each line's amount to
/// its own category and tags (never the whole transaction).
model SplitLine {
  id            String         @id @default(uuid())
  txnId         String
  txn           Transaction    @relation(fields: [txnId], references: [id], onDelete: Cascade)
  idx           Int // display / QBO line order
  amount        Decimal        @db.Decimal(14, 2) // signed, same sign as the txn
  category      String
  categoryQboId String?
  taxCode       String?
  taxCodeQboId  String?
  memo          String?
  tags          SplitLineTag[]

  @@unique([txnId, idx])
  @@index([category])
}

model SplitLineTag {
  splitLineId String
  splitLine   SplitLine @relation(fields: [splitLineId], references: [id], onDelete: Cascade)
  tagId       String
  tag         Tag       @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([splitLineId, tagId])
}

model TxnTag {
  txnId String
  txn   Transaction @relation(fields: [txnId], references: [id], onDelete: Cascade)
  tagId String
  tag   Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([txnId, tagId])
}

/// A company-local vendor identity. `displayName` is the bounded raw value
/// received from QBO or a user; `normalizedName` is only the deterministic
/// NFC/trim/collapsed-whitespace/lowercase lookup key. No fuzzy similarity or
/// automatic merge is represented by this model.
model VendorIdentity {
  id                  String               @id @default(uuid())
  companyId           String
  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qboVendorId         String?              @db.VarChar(120)
  displayName         String               @db.VarChar(500)
  normalizedName      String               @db.VarChar(500)
  aliases             VendorAlias[]
  classificationCases ClassificationCase[]
  mergeAsSource       VendorIdentityMerge?  @relation("VendorIdentityMergeSource")
  mergesAsTarget      VendorIdentityMerge[] @relation("VendorIdentityMergeTarget")
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([companyId, id])
  @@unique([companyId, normalizedName])
  @@unique([companyId, qboVendorId])
  @@index([companyId, qboVendorId])
}

/// Raw aliases are retained for auditability; matching uses only the stored
/// deterministic key. A key can belong to one identity in one company.
model VendorAlias {
  id               String         @id @default(uuid())
  companyId        String
  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  vendorIdentityId String
  vendorIdentity   VendorIdentity @relation(fields: [companyId, vendorIdentityId], references: [companyId, id], onDelete: Cascade)
  value            String         @db.VarChar(500)
  normalizedValue  String         @db.VarChar(500)
  source           String         @db.VarChar(32)
  createdAt        DateTime       @default(now())

  @@unique([companyId, id])
  @@unique([companyId, normalizedValue])
  @@index([companyId, vendorIdentityId])
  @@index([companyId, normalizedValue])
}

/// An explicit, immutable audit event joining one reviewed duplicate identity
/// to its canonical target. Exact lookup never creates this row implicitly.
model VendorIdentityMerge {
  id                     String         @id @default(uuid())
  companyId              String
  company                Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceVendorIdentityId String
  sourceVendorIdentity   VendorIdentity @relation("VendorIdentityMergeSource", fields: [companyId, sourceVendorIdentityId], references: [companyId, id], onDelete: Cascade)
  targetVendorIdentityId String
  targetVendorIdentity   VendorIdentity @relation("VendorIdentityMergeTarget", fields: [companyId, targetVendorIdentityId], references: [companyId, id], onDelete: Cascade)
  mergedBy               String         @db.VarChar(128)
  reason                 String         @db.VarChar(500)
  createdAt              DateTime       @default(now())

  @@unique([companyId, id])
  @@unique([companyId, sourceVendorIdentityId])
  @@index([companyId, targetVendorIdentityId])
}

/// Append-only display-only historical source snapshots. They are advisory
/// evidence, never verified classification cases or executable policy.
model HistoricalClassificationObservation {
  id                        String      @id @default(uuid())
  companyId                 String
  company                   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sourceTransactionId       String
  sourceTransaction         Transaction @relation(fields: [companyId, sourceTransactionId], references: [companyId, id], onDelete: Restrict)
  sourceQboType             String      @db.VarChar(32)
  sourceQboId               String      @db.VarChar(128)
  sourceTransactionRevision Int
  sourceQboSyncToken        String      @db.VarChar(128)
  sourceStatus              TxnStatus
  sourceUpdatedAt           DateTime
  observedAt                DateTime    @default(now())
  transactionDate           DateTime
  payee                     String      @db.VarChar(500)
  memo                      String?     @db.VarChar(2000)
  amountCents               BigInt
  currency                  String      @db.Char(3)
  sourceAccountName         String      @db.VarChar(500)
  categoryName              String      @db.VarChar(500)
  categoryQboId             String      @db.VarChar(120)
  taxCalculation            String      @db.VarChar(32)
  taxCodeName               String?     @db.VarChar(500)
  taxCodeQboId              String?     @db.VarChar(120)
  tagNames                  Json        @default("[]")

  @@unique([companyId, sourceQboType, sourceQboId, sourceTransactionRevision, sourceQboSyncToken])
  @@index([companyId, observedAt])
  @@index([companyId, sourceTransactionId])
}

/// Immutable evidence produced only from a verified QBO mutation attempt.
/// Typed columns support bounded indexed reads; `snapshot` is a structured,
/// allow-listed copy of the transaction/action/evidence context and is never
/// a provider payload or raw QBO response.
model ClassificationCase {
  id                   String             @id @default(uuid())
  companyId            String
  company              Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId        String
  transaction          Transaction        @relation(fields: [companyId, transactionId], references: [companyId, id], onDelete: Cascade)
  vendorIdentityId     String?
  vendorIdentity       VendorIdentity?    @relation(fields: [companyId, vendorIdentityId], references: [companyId, id], onDelete: Cascade)
  qboMutationAttemptId String             @unique
  qboMutationAttempt   QboMutationAttempt @relation(fields: [transactionId, qboMutationAttemptId], references: [transactionId, id], onDelete: Cascade)
  action               Json
  actionFingerprint    String             @db.Char(64)
  originIntent         String             @db.VarChar(32)
  rationale            String             @db.VarChar(2000)
  requiredEvidence     Json               @default("[]")
  examples             Json               @default("[]")
  counterexamples      Json               @default("[]")
  citations            Json               @default("[]")
  reviewer             Json
  jurisdiction         String             @db.VarChar(128)
  currency             String             @db.Char(3)
  context              Json
  provenance           Json
  /// Structured bounded transaction context assembled by cases.ts; it
  /// intentionally excludes Transaction.rawData and QBO provider payloads.
  transactionSnapshot  Json
  verifiedAt           DateTime
  createdAt            DateTime           @default(now())
  sourceRules          Rule[]             @relation("RuleSourceCase")
  ruleRevisions        RuleRevision[]     @relation("RuleRevisionSourceCase")
  invalidation          ClassificationCaseInvalidation?

  @@unique([companyId, id])
  @@unique([transactionId, qboMutationAttemptId])
  @@index([companyId, verifiedAt])
  @@index([companyId, transactionId])
  @@index([companyId, vendorIdentityId, verifiedAt])
}

/// A case can be invalidated without rewriting its verified evidence. This is
/// a separate append-only event so the base case remains immutable.
model ClassificationCaseInvalidation {
  id                   String              @id @default(uuid())
  companyId            String
  company              Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  classificationCaseId String
  classificationCase   ClassificationCase @relation(fields: [companyId, classificationCaseId], references: [companyId, id], onDelete: Cascade, map: "ClassificationCaseInvalidation_company_case_fkey")
  invalidatedAt        DateTime            @default(now())
  reason               String              @db.VarChar(500)
  createdAt            DateTime            @default(now())

  @@unique([companyId, id])
  @@unique([companyId, classificationCaseId], map: "ClassificationCaseInvalidation_company_case_key")
  @@index([companyId, invalidatedAt])
}

model Rule {
  id               String                  @id @default(uuid())
  companyId        String
  company          Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Match order: lowest priority number wins when several rules match a payee.
  priority         Int                     @default(0)
  matchField       String                  @default("payee") // v1: payee contains, case-insensitive
  matchText        String
  category         String // category display name
  categoryQboId    String?
  taxCalculation   String?
  taxCode          String?
  taxCodeQboId     String?
  autoPost         Boolean                 @default(false)
  /// Lifecycle state is deliberately separate from the historical autoPost
  /// permission. Existing rules are backfilled as enabled without changing
  /// their autoPost value.
  enabled           Boolean                 @default(true)
  revision          Int                     @default(0)
  originIntent      String?                 @db.VarChar(32)
  sourceCaseId      String?
  sourceCandidateId String?
  retiredAt         DateTime?
  createdById      String?
  createdAt        DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt
  updatedById       String?                 @db.VarChar(128)
  reviewRequiredAt DateTime?
  reviewReason     String?
  ruleTags         RuleTag[]
  candidateOrigin  AutopilotRuleCandidate? @relation("ActivatedCandidateRule")
  revisions         RuleRevision[]
  sourceCase        ClassificationCase?     @relation("RuleSourceCase", fields: [companyId, sourceCaseId], references: [companyId, id], onDelete: Cascade)
  sourceCandidate   AutopilotRuleCandidate? @relation("RuleSourceCandidate", fields: [companyId, sourceCandidateId], references: [companyId, id], onDelete: Cascade)
  canonicalMigrations RuleCanonicalMigration[]
  direction          RuleDirection?
  canonicalVersion   Int?
  repairReason       String?                 @db.VarChar(500)
  affectedJournalEntryCount Int?

  @@unique([companyId, id])
  @@index([companyId, enabled, retiredAt])
}

model RuleTag {
  ruleId String
  rule   Rule   @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  tagId  String
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([ruleId, tagId])
}

/// One immutable version of a Rule. Rule lifecycle writes create a new row;
/// revisions are never edited or deleted, and `state` records the lifecycle
/// at the time of that version rather than being inferred from the live Rule.
model RuleRevision {
  id                String                  @id @default(uuid())
  ruleId            String
  rule              Rule                    @relation(fields: [companyId, ruleId], references: [companyId, id], onDelete: Cascade)
  companyId         String
  company           Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  revision          Int
  state             String                  @default("enabled") @db.VarChar(32)
  matchField        String                  @default("payee") @db.VarChar(64)
  matchText         String                  @db.VarChar(500)
  category          String                  @db.VarChar(500)
  categoryQboId     String?                 @db.VarChar(120)
  taxCalculation    String?                 @db.VarChar(32)
  taxCode           String?                 @db.VarChar(500)
  taxCodeQboId      String?                 @db.VarChar(120)
  tagIds            Json                    @default("[]")
  priority          Int
  autoPost          Boolean
  direction         RuleDirection?
  canonicalVersion  Int?
  repairReason      String?                 @db.VarChar(500)
  affectedJournalEntryCount Int?
  originIntent      String?                 @db.VarChar(32)
  sourceCaseId      String?
  sourceCase        ClassificationCase?     @relation("RuleRevisionSourceCase", fields: [companyId, sourceCaseId], references: [companyId, id], onDelete: Cascade)
  sourceCandidateId String?
  sourceCandidate   AutopilotRuleCandidate? @relation("RuleRevisionSourceCandidate", fields: [companyId, sourceCandidateId], references: [companyId, id], onDelete: Cascade)
  changedBy         String?                 @db.VarChar(128)
  createdAt         DateTime                @default(now())
  retiredAt         DateTime?

  @@unique([companyId, id])
  @@unique([companyId, ruleId, revision])
  @@index([companyId, state, createdAt])
  @@index([companyId, ruleId, revision])
}

/// Exact-once marker for a completed canonical rewrite. Rows are protected by
/// an append-only database trigger and can be removed only by Company cascade.
model RuleCanonicalMigration {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  ruleId           String
  rule             Rule     @relation(fields: [companyId, ruleId], references: [companyId, id], onDelete: Cascade)
  canonicalVersion Int
  sourceRevision   Int
  canonicalRevision Int
  completedAt      DateTime @default(now())

  @@unique([companyId, ruleId, canonicalVersion])
  @@index([companyId, completedAt])
}

/// Durable system-owned envelope for canonical rule auto-post preparation.
/// Scalar transaction/rule/QBO bindings are immutable provenance; the request
/// points to the separately authority-fenced QboMutationAttempt write path.
model RuleAutoPostPreparation {
  id               String   @id @default(uuid())
  companyId        String
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId    String
  ruleId           String
  ruleRevision     Int
  inputHash        String   @db.Char(64)
  proposal         Json
  proposalHash     String   @db.Char(64)
  stagedGraphHash  String   @db.Char(64)
  sourceRevision   Int
  preparedRevision Int
  qboType          String   @db.VarChar(32)
  qboId            String   @db.VarChar(128)
  qboSyncToken     String   @db.VarChar(128)
  requestId        String   @unique @db.VarChar(128)
  state            String   @default("PREPARED") @db.VarChar(32)
  diagnostics      Json     @default("{}")
  errorCode        String?  @db.VarChar(64)
  errorMessage     String?  @db.VarChar(1000)
  commitStartedAt  DateTime?
  completedAt      DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now()) @updatedAt

  @@index([companyId, transactionId])
  @@index([companyId, state, updatedAt])
}

model SavedReport {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  config    Json // { range, flow, account, groupBy, tagIds }
  createdAt DateTime @default(now())
}

// Append-only: the app exposes no update or delete path for this table.
model AuditEntry {
  id         String   @id @default(uuid())
  companyId  String
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  at         DateTime @default(now())
  actorId    String? // userId; null = system
  actorLabel String // display name or 'system'
  txnId      String?
  payee      String
  amount     Decimal  @db.Decimal(14, 2)
  action     String // posted | dry-run | error | reverted | superseded | transfer | auto-posted
  before     String // holding account
  after      String // full category path, or split summary
  payload    Json? // exact QBO request body (dry-run keeps it too)

  @@index([companyId, at])
}

model QboAccount {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qboId          String
  name           String
  fullName       String // "Expenses · Meals" style path
  classification String // Income | COGS | Expenses | Asset | Liability | Equity | Bank | Holding-eligible etc.
  accountType    String?
  active         Boolean  @default(true)
  updatedAt      DateTime @updatedAt

  @@unique([companyId, qboId])
}

model QboTaxRate {
  id          String   @id @default(uuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qboId       String
  name        String
  description String?
  active      Boolean  @default(true)
  // Previously synced caches may retain inactive rows with no value.
  // Runtime tax calculations query only normalized non-null rows.
  rateValue   Decimal? @db.Decimal(9, 6)
  sourceUpdatedAt DateTime?
  updatedAt       DateTime  @updatedAt

  @@unique([companyId, qboId])
}

model QboTaxCode {
  id                      String   @id @default(uuid())
  companyId               String
  company                 Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  qboId                   String
  name                    String
  description             String?
  active                  Boolean  @default(true)
  taxable                 Boolean?
  purchaseTaxRateList     Json
  salesTaxRateList        Json     @default("[]")
  combinedPurchaseRate    Decimal? @db.Decimal(9, 6)
  combinedSalesRate       Decimal? @db.Decimal(9, 6)
  sourceUpdatedAt         DateTime?
  updatedAt               DateTime @updatedAt

  @@unique([companyId, qboId])
}

model SyncLog {
  id        String   @id @default(uuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  kind      String // poll | webhook | manual | nightly | initial
  ok        Boolean
  message   String
  at        DateTime @default(now())

  @@index([companyId, at])
}

model QboEntityLease {
  companyId      String
  qboType        String
  qboId          String
  owner          String
  leaseExpiresAt DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@id([companyId, qboType, qboId])
  @@index([leaseExpiresAt])
}

model QboMutationAttempt {
  id                    String      @id @default(uuid())
  transactionId         String
  transaction           Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  requestId             String      @unique
  operation             String
  status                String
  expectedRevision      Int
  expectedSyncToken     String
  requestHash           String
  requestPayload        Json
  beforeSnapshot        Json
  responseSnapshot      Json?
  verification          Json?
  errorCode             String?
  errorMessage          String?
  classificationEnvelopeVersion Int?
  classificationEnvelopeHash    String?     @db.VarChar(64)
  ruleCandidateFoldedAt DateTime?
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
  classificationCase    ClassificationCase?

  @@unique([transactionId, id])
  @@index([transactionId, status])
}

/// Immutable coordinator for the two durable attempts that make up a transfer.
/// Deliberate scalar identities retain recovery evidence without cascading FKs.
model QboTransferOperation {
  id                       String   @id @default(uuid())
  actorId                  String
  companyId                String
  firstTransactionId       String
  secondTransactionId      String
  firstExpectedRevision    Int
  secondExpectedRevision   Int
  firstQboType             String   @db.VarChar(32)
  firstQboId               String   @db.VarChar(128)
  firstQboSyncToken        String   @db.VarChar(128)
  firstTargetAccountQboId  String   @db.VarChar(128)
  firstAttemptRequestId    String   @db.VarChar(128)
  secondQboType            String   @db.VarChar(32)
  secondQboId              String   @db.VarChar(128)
  secondQboSyncToken       String   @db.VarChar(128)
  secondTargetAccountQboId String   @db.VarChar(128)
  secondAttemptRequestId   String   @db.VarChar(128)
  idempotencyHash          String   @db.Char(64)
  inputHash                String   @db.Char(64)
  preparedHash             String   @db.Char(64)
  expiresAt                DateTime
  retryOfId                String?  @unique
  createdAt                DateTime @default(now())

  @@unique([actorId, companyId, firstTransactionId, secondTransactionId, idempotencyHash])
  @@index([companyId, firstTransactionId, secondTransactionId])
}

/// Immutable MCP preparation envelope. Attribution and target identifiers are
/// deliberate scalars so account or token deletion cannot erase audit history.
/// QBO write authority remains exclusively in QboMutationAttempt.
model McpOperation {
  id               String    @id @default(uuid())
  tokenId          String
  tokenPrefix      String    @db.VarChar(12)
  userId           String
  companyId        String
  transactionId    String
  toolName         String    @db.VarChar(64)
  kind             String    @db.VarChar(32)
  idempotencyKey   String?   @db.VarChar(128)
  inputHash        String    @db.Char(64)
  payload          Json
  payloadHash      String    @db.Char(64)
  sourceRevision   Int
  preparedRevision Int
  qboType          String    @db.VarChar(32)
  qboId            String    @db.VarChar(128)
  qboSyncToken     String    @db.VarChar(128)
  expiresAt        DateTime
  retryOfId        String?   @unique
  cancelledAt      DateTime?
  manualRecordedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([tokenId, toolName, transactionId, idempotencyKey])
  @@index([tokenId, createdAt])
  @@index([userId, createdAt])
  @@index([companyId, transactionId])
}

/// Immutable MCP preparation envelope for rule lifecycle mutations. This is
/// deliberately separate from McpOperation because rule writes are local
/// classification-policy changes, not transaction-scoped QBO operations.
/// Attribution and target identifiers remain scalar provenance after deletion.
model McpRuleOperation {
  id                   String    @id @default(uuid())
  authKind             String    @default("mcp") @db.VarChar(16)
  tokenId              String?
  tokenPrefix          String?   @db.VarChar(12)
  sessionId            String?
  userId               String
  companyId            String
  resourceType         String    @db.VarChar(32)
  resourceId           String
  mutation             String    @db.VarChar(32)
  idempotencyKey       String    @db.VarChar(128)
  inputHash            String    @db.Char(64)
  payload              Json
  payloadHash          String    @db.Char(64)
  sourceRevision       Int
  proposedRevision     Int
  proposedSnapshotHash String    @db.Char(64)
  expiresAt            DateTime
  retryOfId            String?   @unique
  committedAt          DateTime?
  commitResult         Json?
  commitResultHash     String?   @db.Char(64)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@unique([tokenId, companyId, idempotencyKey])
  @@unique([sessionId, companyId, idempotencyKey])
  @@index([tokenId, createdAt])
  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@index([companyId, resourceType, resourceId])
}

model AppConfig {
  key       String   @id
  value     String // encrypted where sensitive
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model AgentCompanyConfig {
  companyId                   String    @id
  company                     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  mode                        String    @default("off")
  /// A provider name only. Credentials remain in encrypted instance settings.
  provider                    String
  decisionModel               String
  verifierModel               String
  scheduleMinutes             Int       @default(10)
  companyConcurrency          Int       @default(1)
  evidenceThreshold           Int       @default(50)
  dailyLiveWriteLimit         Int       @default(25)
  limits                      Json
  configVersion               String
  /// Explicit operator scheduling intent; separate from model/evidence identity.
  schedulingGeneration        Int       @default(0)
  liveRequested               Boolean   @default(false)
  liveAcceptedPolicyVersion   String?
  liveAcceptedConfigVersion   String?
  liveAcceptedProviderBinding String?
  liveEnabledAt               DateTime?
  liveEnabledByUserId         String?
  livePausedAt                DateTime?
  livePauseCode               String?
  livePauseMessage            String?
  updatedAt                   DateTime  @updatedAt
}

model LiveWritePermit {
  requestId    String   @id
  companyId    String
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  utcDay       DateTime @db.Date
  limitAtIssue Int
  createdAt    DateTime @default(now())

  @@index([companyId, utcDay])
}

model AgentJob {
  id                   String     @id @default(uuid())
  companyId            String
  company              Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId        String
  revision             Int
  configVersion        String
  schedulingGeneration Int        @default(0)
  status               String
  dueAt                DateTime
  lockOwner            String?
  leaseExpiresAt       DateTime?
  attemptCount         Int        @default(0)
  lastErrorCode        String?
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  runs                 AgentRun[]

  @@unique([companyId, transactionId, revision, configVersion, schedulingGeneration], map: "AgentJob_scheduling_intent_key")
  @@index([status, dueAt])
}

model AgentRun {
  id            String    @id @default(uuid())
  jobId         String
  job           AgentJob  @relation(fields: [jobId], references: [id], onDelete: Cascade)
  companyId     String
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId String
  revision      Int
  configVersion String
  attemptCount  Int
  status        String
  snapshot      Json
  decision      Json?
  verification  Json?
  decisionModel String
  verifierModel String
  verifierKind  String
  promptVersion String
  schemaVersion String
  durationMs    Int?
  usage         Json?
  errorCode     String?
  createdAt     DateTime  @default(now())
  completedAt   DateTime?

  @@unique([jobId, attemptCount])
  @@index([companyId, createdAt])
  @@index([transactionId, revision])
}

/// Inert, explainable rule proposal derived only from durable VERIFIED writes.
/// State values are gathering | ready | conflict | dismissed | activated | stale.
model AutopilotRuleCandidate {
  id                          String                           @id @default(uuid())
  companyId                   String
  company                     Company                          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  conditionFingerprint        String
  schemaVersion               String
  configVersion               String
  matchField                  String                           @default("payee")
  matchText                   String
  state                       String                           @default("gathering")
  winningActionFingerprint    String?
  categoryQboId               String?
  taxCalculation              String?
  taxCodeQboId                String?
  tagIds                      Json                             @default("[]")
  evidenceCount               Int                              @default(0)
  conflictingEvidenceCount    Int                              @default(0)
  dismissedAt                 DateTime?
  dismissedByUserId           String?
  activatedAt                 DateTime?
  activatedByUserId           String?
  activationEvidenceCount     Int?
  activationActionFingerprint String?
  activatedRuleId             String?                          @unique
  activatedRule               Rule?                            @relation("ActivatedCandidateRule", fields: [activatedRuleId], references: [id], onDelete: SetNull)
  sourceRules                 Rule[]                           @relation("RuleSourceCandidate")
  sourceRuleRevisions         RuleRevision[]                   @relation("RuleRevisionSourceCandidate")
  evidence                    AutopilotRuleCandidateEvidence[]
  createdAt                   DateTime                         @default(now())
  updatedAt                   DateTime                         @updatedAt

  @@unique([companyId, conditionFingerprint, schemaVersion, configVersion])
  @@unique([companyId, id])
  @@index([companyId, state, updatedAt])
}

/// Append-preserving positive and negative outcome evidence. A later verified
/// outcome marks earlier rows inactive; the request/candidate key plus the fold
/// receipt make replay idempotent without deleting history.
model AutopilotRuleCandidateEvidence {
  id                 String                 @id @default(uuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  candidateId        String
  candidate          AutopilotRuleCandidate @relation(fields: [companyId, candidateId], references: [companyId, id], onDelete: Cascade)
  transactionId      String
  transaction        Transaction            @relation(fields: [companyId, transactionId], references: [companyId, id], onDelete: Cascade)
  inputRevision      Int
  requestId          String
  source             String
  polarity           String                 @default("positive")
  actionFingerprint  String
  pattern            Json
  active             Boolean                @default(true)
  observedAt         DateTime               @default(now())
  invalidatedAt      DateTime?
  invalidationReason String?

  @@index([candidateId, active])
  @@index([transactionId, active])
  @@index([companyId, active])
  @@unique([requestId, candidateId])
}

/// Immutable receipt showing that one durable VERIFIED mutation was considered.
/// It prevents a replay from moving evidence after mutable transaction data or
/// company configuration changes.
model AutopilotRuleCandidateFold {
  requestId     String      @id
  companyId     String
  company       Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  operation     String
  processedAt   DateTime    @default(now())

  @@index([companyId, processedAt])
  @@index([transactionId])
}

model WebhookEvent {
  id          String    @id @default(uuid())
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

/// Finite rediscovery intent for contention before any durable preparation.
model RulePreparationRetry {
  id             String   @id @default(uuid())
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactionId  String
  sourceRevision Int
  ruleId         String
  ruleRevision   Int
  state          String   @default("PENDING")
  attemptCount   Int      @default(0)
  dueAt          DateTime
  claimToken     String?
  createdAt      DateTime @default(now())

  @@unique([companyId, transactionId, sourceRevision, ruleId, ruleRevision], map: "RulePreparationRetry_binding_key")
  @@index([state, dueAt])
}
